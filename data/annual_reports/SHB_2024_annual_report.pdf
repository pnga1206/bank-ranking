         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Financial Consulting for Business Banner</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Financial administration concept. Consulting for company performance, analysis concept. Statistics and business statement. Flat isometric infographics for banner or business hero images.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Francesca Coati</rdf:li>
            </rdf:Seq>
         </dc:creator>
